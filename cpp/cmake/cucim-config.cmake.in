@PACKAGE_INIT@

# Find dependent libraries
# ...
include(CMakeFindDependencyMacro)
#find_dependency(Boost x.x.x REQUIRED)
find_dependency(CUDAToolkit)

# <cucim/memory/device_resource.h> is a public header and exposes cuda::mr
# types, so consumers need CCCL's headers.
#
# libcudacxx is the only component cuCIM uses. Asking for it alone does not
# make CCCL's other components optional - libcudacxx's own config file refers
# to Thrust::Thrust and CUB::CUB, and they ship together in any case - but it
# does skip configuring a default CCCL::Thrust target, which cuCIM has no use
# for.
#
# The minimum is the version libcucim was built against; CCCL accepts any newer
# 3.x as compatible. The hint is the copy rapids-cmake installs next to cuCIM.
# A compatible CCCL found earlier in the search, such as one a consumer already
# pulled in through rapids-cmake, is used instead.
find_dependency(CCCL @CCCL_VERSION@ CONFIG COMPONENTS libcudacxx
    HINTS "${PACKAGE_PREFIX_DIR}/@CUCIM_CCCL_INSTALL_LIBDIR@/cmake/cccl")

if(NOT TARGET cucim::cucim)
    include(${CMAKE_CURRENT_LIST_DIR}/cucim-targets.cmake)
endif()
